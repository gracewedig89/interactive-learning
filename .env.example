# Copy this file to .env and fill it in. Never commit .env.

# --- AI tutor (required for chat + lessons built from Canvas) ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Canvas ---
CANVAS_BASE_URL=https://utahtech.instructure.com
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=
# Optional: pin a class to an exact Canvas course id (the number in the course URL)
# if the automatic name match picks the wrong one.
# CANVAS_COURSE_ACCOUNTING=
# CANVAS_COURSE_SQL=
# CANVAS_COURSE_LANGUAGE_ARTS=

# --- Text reminders (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, e.g. +14355550100
TWILIO_FROM=
# Your cell phone, in +1XXXXXXXXXX format
SMS_TO=
# Public address of this app, used for the links inside texts
APP_URL=http://localhost:3000
TIMEZONE=America/Denver
# Weekly "due this week" text (cron format). Default: Mondays 8:00 AM.
DIGEST_CRON=0 8 * * 1
# Hours before each due date to text you
REMINDER_HOURS=48,6

# --- Optional ---
# Require a password to open the app (use this if you host it online)
# APP_PASSWORD=
# PORT=3000
